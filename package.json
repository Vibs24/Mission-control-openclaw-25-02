{
  "name": "pulsedesk-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @pulsedesk/api & npm run dev -w @pulsedesk/web",
    "build": "npm run build -ws",
    "test": "npm run test -ws",
    "lint": "npm run lint -ws",
    "smoke": "npm run smoke -w @pulsedesk/api"
  }
}
